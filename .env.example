# Required: TinyFish (TinySet, Search, Fetch, Agent). https://agent.tinyfish.ai
TINYFISH_API_KEY=your_tinyfish_api_key
# TINYFISH_BASE_URL=https://agent.tinyfish.ai

# Recommended: Gemini turns the description into a profile, rates similarity, extracts partners.
# Without it the app falls back to keyword heuristics.
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=

# Optional tuning
# TINYSET_ROWS=40
# TINYSET_MAX_WAIT_MS=480000
